# Flask & Server
SECRET_KEY=default-dev-secret-key-12345
FLASK_ENV=development
PORT=5000

# LLM Provider ('gemini', 'groq', or 'mock')
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Speech-to-Text & Text-to-Speech ('gemini', 'groq', or 'mock')
STT_PROVIDER=mock
TTS_PROVIDER=mock
GROQ_STT_MODEL=whisper-large-v3

# Database (Leave empty for automatic local SQLite at instance/ai_business_agent.db)
DATABASE_URL=

# Multi-tenant Defaults
DEFAULT_BUSINESS_ID=1
BUSINESS_TIMEZONE=Asia/Karachi

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
