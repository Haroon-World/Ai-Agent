+    except Exception as e:
+        return jsonify({"success": False, "error": f"Speech synthesis failed: {str(e)}"}), 400
+
+    return Response(
+        audio_bytes,
+        mimetype="audio/wav",
+        headers={"Content-Disposition": "inline; filename=reply.wav"}
+    )
